FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:222759b391a1aaf241166672c8f99b2d4ada452e7b5319f3c6e8f265a37b5ad4 AS base
USER $APP_UID
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:e70cdb7f80b0348f5cb85f19a8f670fca061f033d57eed12fa003d58b0e06317 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["Signal.Bot.Example/Signal.Bot.Example.csproj", "Signal.Bot.Example/"]
COPY ["Signal.Bot/Signal.Bot.csproj", "Signal.Bot/"]
RUN dotnet restore "Signal.Bot.Example/Signal.Bot.Example.csproj"
COPY . .
WORKDIR "/src/Signal.Bot.Example"
RUN dotnet build "./Signal.Bot.Example.csproj" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./Signal.Bot.Example.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "Signal.Bot.Example.dll"]
